#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 900   // mousescroll SPEED

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <3000>; // Only turn off it the key is held for 3 seconds or longer.
};

&mt {
    tapping-term-ms = <300>;
    flavor = "tap-preferred";
};

&lt { tapping-term-ms = <300>; };

/ {
    behaviors {
        Scroll_D_U: Scroll_D_U {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_D_U";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        TD01: TD01 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD01";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp PERIOD>;
        };

        Scroll_U_D: Scroll_U_D {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_U_D";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        Scroll_LR: Scroll_LR {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_LR";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };

        Scroll_RL: Scroll_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_RL";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;

            tap-ms = <20>;
        };
    };

    combos {
        compatible = "zmk,combos";

        boot {
            bindings = <&bootloader>;
            key-positions = <33 32 30>;
        };

        boot2 {
            bindings = <&bootloader>;
            key-positions = <36 37 39>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Main_Layer {
            display-name = "main";
            bindings = <
&kp Q          &kp W        &kp E             &kp R        &kp T      &kp Y       &kp U        &kp I             &kp O        &kp P
&mt LGUI A     &mt LCTRL S  &mt LALT D        &mt LSHFT F  &kp G      &kp H       &mt RSHFT J  &mt RALT K        &mt RCTRL L  &mt RGUI SEMI
&kp Z          &kp X        &kp C             &kp V        &kp B      &kp N       &kp M        &kp COMMA         &kp DOT      &kp FSLH
&mt LSHFT ESC  &lt 5 ESC    &lt 1 SPACE       &lt 3 TAB    &kp CAPS   &kp K_MUTE  &lt 2 BSPC   &kp ENTER         &kp DEL      &kp RSHFT
&kp LEFT       &kp UP       &kp C_PLAY_PAUSE  &kp DOWN     &kp RIGHT  &kp LEFT    &kp DOWN     &kp C_PLAY_PAUSE  &kp UP       &kp RIGHT
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_LR>;
        };

        Number {
            display-name = "num";
            bindings = <
&trans        &kp F9               &kp F10          &kp F11            &kp F12  &kp PLUS        &kp N7              &kp N8            &kp N9                &kp FSLH
&kp LEFT_GUI  &mt LEFT_CONTROL F5  &mt LEFT_ALT F6  &mt LEFT_SHIFT F7  &kp F8   &kp N0          &mt RIGHT_SHIFT N4  &mt RIGHT_ALT N5  &mt RIGHT_CONTROL N6  &mt RIGHT_GUI DOT
&trans        &kp F1               &kp F2           &kp F3             &kp F4   &kp MINUS       &kp N1              &kp N2            &kp N3                &kp STAR
&trans        &trans               &trans           &trans             &trans   &kp KP_NUMLOCK  &trans              &trans            &trans                &trans
&trans        &trans               &trans           &trans             &trans   &trans          &trans              &trans            &trans                &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp UP DOWN>;
        };

        Sym {
            display-name = "sym";
            bindings = <
&kp LS(EXCL)  &kp LS(AT)        &kp LS(POUND)  &kp LS(DLLR)  &kp LS(PRCNT)  &kp LS(CARET)         &kp LS(AMPS)         &kp LS(STAR)        &kp LS(LPAR)            &kp LS(RPAR)
&kp GRAVE     &kp LEFT_CONTROL  &kp LALT       &kp LSHFT     &trans         &kp LS(LC(LA(SEMI)))  &mt RIGHT_SHIFT SQT  &mt RIGHT_ALT LBKT  &mt RIGHT_CONTROL RBKT  &mt RIGHT_GUI BSLH
&trans        &trans            &trans         &trans        &trans         &kp MINUS             &kp EQUAL            &kp COMMA           &kp DOT                 &kp FSLH
&trans        &trans            &trans         &trans        &trans         &trans                &trans               &trans              &trans                  &trans
&trans        &trans            &trans         &trans        &trans         &trans                &trans               &trans              &trans                  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_NEXT C_PREVIOUS>,
                <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        Movement {
            bindings = <
&trans     &mkp MB5   &mkp MCLK  &mkp RCLK  &mkp LCLK  &kp HOME  &kp END   &kp PG_UP  &kp PG_DN  &trans
&trans     &mkp MB5   &kp BSPC   &kp RET    &kp DEL    &kp LEFT  &kp DOWN  &kp UP     &kp RIGHT  &trans
&kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &trans     &trans    &trans    &trans     &trans     &trans
&trans     &trans     &trans     &trans     &trans     &trans    &trans    &trans     &trans     &trans
&trans     &trans     &trans     &trans     &trans     &trans    &trans    &trans     &trans     &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>,
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        layer_4 {
            bindings = <
&trans     &kp LC(W)  &kp LC(E)  &kp LC(R)  &kp LC(T)  &trans  &trans  &trans        &trans        &trans
&kp LC(A)  &kp LC(S)  &kp LC(D)  &kp LC(F)  &trans     &trans  &trans  &kp LS(LBRC)  &kp LS(RBRC)  &kp LS(PIPE)
&trans     &trans     &trans     &trans     &trans     &trans  &trans  &trans        &trans        &trans
&trans     &trans     &trans     &trans     &trans     &trans  &trans  &trans        &trans        &trans
&trans     &trans     &trans     &trans     &trans     &trans  &trans  &trans        &trans        &trans
            >;
        };

        left_num {
            bindings = <
&trans  &kp N7  &kp N8  &kp N9  &trans   &trans  &trans  &trans  &trans  &trans
&trans  &kp N4  &kp N5  &kp N6  &kp DOT  &trans  &trans  &trans  &trans  &trans
&trans  &kp N1  &kp N2  &kp N3  &trans   &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
